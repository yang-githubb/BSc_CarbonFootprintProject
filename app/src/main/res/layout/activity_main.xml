<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. How many people live in your household?"
                android:layout_marginBottom="8dp"/>
            <RadioGroup
                android:id="@+id/question1RadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/q1_option1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"/>
                <RadioButton
                    android:id="@+id/q1_option2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"/>
                <RadioButton
                    android:id="@+id/q1_option3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"/>
                <RadioButton
                    android:id="@+id/q1_option4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4"/>
                <RadioButton
                    android:id="@+id/q1_option5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="More than 4"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="2. What is the source of energy?" />
            </RadioGroup>

            <RadioGroup
                android:id="@+id/question2RadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/q2_option1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Renewable Energy"/>
                <RadioButton
                    android:id="@+id/q2_option2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Electricity"/>
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="3. How much energy do you approximately consume monthly? (To the average of three months bill)" />

            <RadioGroup
                android:id="@+id/question3RadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/q3_option1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Below 100kWh"/>
                <RadioButton
                    android:id="@+id/q3_option2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100-199kWh"/>
                <RadioButton
                    android:id="@+id/q3_option3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="200-399kWh"/>
                <RadioButton
                    android:id="@+id/q3_option4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="400-599kWh"/>
                <RadioButton
                    android:id="@+id/q3_option6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="More than 600kWh"/>
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. How do you take a bath on daily basis?"
                android:layout_marginBottom="8dp"/>
            <RadioGroup
                android:id="@+id/question4RadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/q4_option1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shower with no heater"/>
                <RadioButton
                    android:id="@+id/q4_option2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shower with heater (warm water)"/>
                <RadioButton
                    android:id="@+id/q4_option3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shower with heater (hot water)"/>
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5. How often do you do laundry?"
                android:layout_marginBottom="8dp"/>
            <RadioGroup
                android:id="@+id/question5RadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/q5_option1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily"/>
                <RadioButton
                    android:id="@+id/q5_option2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Once a week"/>
                <RadioButton
                    android:id="@+id/q5_option3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Twice a week"/>
                <RadioButton
                    android:id="@+id/q5_option4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Once a month"/>
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6. How do you dry clothes after washing them?"
                android:layout_marginBottom="8dp"/>
            <RadioGroup
                android:id="@+id/question6RadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/q6_option1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rack"/>
                <RadioButton
                    android:id="@+id/q6_option2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dryer"/>
                <RadioButton
                    android:id="@+id/q6_option3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Send to launderette"/>
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7. Where do you usually purchase groceries?"
                android:layout_marginBottom="8dp"/>
            <RadioGroup
                android:id="@+id/question7RadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/q7_option1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Supermarket"/>
                <RadioButton
                    android:id="@+id/q7_option2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Online"/>
                <RadioButton
                    android:id="@+id/q7_option3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Local market (pasar)"/>
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8. How much do you usually spend on groceries weekly?"
                android:layout_marginBottom="8dp"/>
            <RadioGroup
                android:id="@+id/question8RadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/q8_option1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Below RM200"/>
                <RadioButton
                    android:id="@+id/q8_option2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RM200-RM399"/>
                <RadioButton
                    android:id="@+id/q8_option3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RM400-RM600"/>
                <RadioButton
                    android:id="@+id/q8_option4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="More than RM600"/>
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9. How frequently do you eat at restaurnt on weekly basis?"
                android:layout_marginBottom="8dp"/>
            <RadioGroup
                android:id="@+id/question9RadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/q9_option1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Never"/>
                <RadioButton
                    android:id="@+id/q9_option2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rarely"/>
                <RadioButton
                    android:id="@+id/q9_option3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Often"/>
                <RadioButton
                    android:id="@+id/q9_option4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Always"/>
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10. Do you pack the leftover food in a restaurant when leaving?"
                android:layout_marginBottom="8dp"/>
            <RadioGroup
                android:id="@+id/question10RadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/q10_option1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No"/>
                <RadioButton
                    android:id="@+id/q10_option2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yes"/>
                <RadioButton
                    android:id="@+id/q10_option3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Depends"/>
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11. If the food that you have prepared is not finished, will you keep the leftover?"
                android:layout_marginBottom="8dp"/>
            <RadioGroup
                android:id="@+id/question11RadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/q11_option1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No"/>
                <RadioButton
                    android:id="@+id/q11_option2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yes"/>
                <RadioButton
                    android:id="@+id/q11_option3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Depends"/>
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12. Will you try your best to finish the food on your plate?"
                android:layout_marginBottom="8dp"/>
            <RadioGroup
                android:id="@+id/question12RadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/q12_option1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No"/>
                <RadioButton
                    android:id="@+id/q12_option2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yes"/>
                <RadioButton
                    android:id="@+id/q12_option3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Depends"/>
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="13. How frequently do you bring your bag whenever you plan to buy something, at the mall?"
                android:layout_marginBottom="8dp"/>
            <RadioGroup
                android:id="@+id/question13RadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/q13_option1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Never"/>
                <RadioButton
                    android:id="@+id/q13_option2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rarely"/>
                <RadioButton
                    android:id="@+id/q13_option3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Often"/>
                <RadioButton
                    android:id="@+id/q13_option4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Always"/>
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14. Do you or your family member own a Hybrid or electronic car?"
                android:layout_marginBottom="8dp"/>
            <RadioGroup
                android:id="@+id/question14RadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/q14_option1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No"/>
                <RadioButton
                    android:id="@+id/q14_option2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yes"/>
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15. How much do you spend for your fuel on weekly basis?"
                android:layout_marginBottom="8dp"/>
            <RadioGroup
                android:id="@+id/question15RadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/q15_option1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RM0 - RM49"/>
                <RadioButton
                    android:id="@+id/q15_option2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RM50 - RM99"/>
                <RadioButton
                    android:id="@+id/q15_option3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RM100 - RM199"/>
                <RadioButton
                    android:id="@+id/q15_option4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RM200 - RM299"/>
                <RadioButton
                    android:id="@+id/q15_option5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="More than RM300"/>
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16. How do you go to school?"
                android:layout_marginBottom="8dp"/>
            <RadioGroup
                android:id="@+id/question16RadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/q16_option1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Walk"/>
                <RadioButton
                    android:id="@+id/q16_option2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bus"/>
                <RadioButton
                    android:id="@+id/q16_option3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bike"/>
                <RadioButton
                    android:id="@+id/q16_option4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Personal vehicle"/>
                <RadioButton
                    android:id="@+id/q16_option5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Other"/>
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="17. What means of transport do you use the most?"
                android:layout_marginBottom="8dp"/>

            <RadioGroup
                android:id="@+id/question17RadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/q17_option1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Walk" />

                <RadioButton
                    android:id="@+id/q17_option2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bus" />

                <RadioButton
                    android:id="@+id/q17_option3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bike" />

                <RadioButton
                    android:id="@+id/q17_option4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Personal vehicle" />

                <RadioButton
                    android:id="@+id/q17_option5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Other" />
            </RadioGroup>

            <Button
                android:id="@+id/submit_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Submit"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>