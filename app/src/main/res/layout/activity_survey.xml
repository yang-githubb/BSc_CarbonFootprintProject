                            <RadioButton
                                android:id="@+id/q10_option1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/no" />

                            <RadioButton
                                android:id="@+id/q10_option2"
                                android:layout_width="wrap_content"
